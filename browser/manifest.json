{
  "manifest_version": 3,
  "name": "Pocketdesk: send to phone",
  "version": "0.4.0",
  "description": "Send the page, a link or an image to your phone through Pocketdesk on this computer.",
  "key": "",
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pocketdesk@pocketdesk.dev",
      "strict_min_version": "121.0"
    }
  }
}
