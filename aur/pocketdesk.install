post_install() {
  echo ">>> Pocketdesk has been installed."
  echo ">>> Configuration: ~/.config/pocketdesk/config.toml"
  echo ">>> Copy config.toml.example to ~/.config/pocketdesk/config.toml"
  echo ">>> Enable with: systemctl --user enable --now pocketdesk.service"
}

post_upgrade() {
  post_install
}
