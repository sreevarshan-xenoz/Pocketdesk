<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17+ blocks every connection to the local network (LAN TCP,
         QUIC, mDNS) for apps targeting it until this is granted. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- T10k: this phone's screen on the computer, only while the owner casts it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- F6: the back camera shown on the computer, as a cast. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- D1: after a system update, say what stopped working. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- D1: Advanced Protection keeps the control service to accessibility tools on Android 17. -->
    <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE" />
    <!-- N1: the ring from the computer onto the lock screen, only while it rings. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- N5b: texts on the computer and replies from it; both asked for only
         when the user turns them on. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- T8e: a forwarded text's sender name, only with "Names from my contacts" on. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- F5: ringing calls on the computer (the phone's state, the number from
         the call log), and declining them from the computer. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- T10h: new screenshots to the computer, only while that switch is on. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 14+: "selected photos only" is handled; Settings asks for all photos, as new screenshots need. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Texts are optional: the app installs on tablets and phones without a
         SIM, and simply has nothing to forward there. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Scanning a desktop's pairing code; the app works without a camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- R4 E2 mic-share needs a mic but the app is fully usable without one. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pocketdesk">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A desktop pairing code (pocketdesk://pair?...), opened by a scan. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pocketdesk" android:host="pair" />
            </intent-filter>
            <!-- N2: the saved computers as Direct Share targets. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="@string/share_target_label"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- N2: text selected in any app goes to the computer's clipboard. -->
        <activity-alias
            android:name=".ToComputer"
            android:exported="true"
            android:label="@string/to_computer_label"
            android:targetActivity=".ShareActivity">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- T8a: a link shared here opens in the computer's browser. -->
        <activity-alias
            android:name=".OpenOnComputer"
            android:exported="true"
            android:label="@string/open_on_computer_label"
            android:targetActivity=".ShareActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".service.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".cast.CastService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|camera" />

        <!-- C8: control from the computer during a cast; only Android binds it. -->
        <service
            android:name=".control.ControlService"
            android:exported="true"
            android:label="@string/control_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/control_service" />
        </service>

        <service
            android:name=".service.SessionForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains the user-initiated remote-desktop QUIC video/input session while the app is backgrounded" />
        </service>

        <receiver
            android:name=".ui.NotificationReplyReceiver"
            android:exported="false" />

        <!-- T10b: reads the clipboard once in focus, sends it, closes; never shown. -->
        <!-- F3: the camera, for a photo the computer asked for. -->
        <activity
            android:name=".files.CameraActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".clip.SendClipboardActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- T10b: the phone's clipboard to its computer from Quick Settings. -->
        <service
            android:name=".shortcuts.SendClipboardTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_pocketdesk"
            android:label="@string/send_clipboard_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- F11: one tap to the last computer from Quick Settings. -->
        <service
            android:name=".shortcuts.ConnectTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_pocketdesk"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- F11: the last computer on the home screen. -->
        <receiver
            android:name=".shortcuts.ConnectWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_connect_info" />
        </receiver>
        <!-- G1: the last computer's state on the home screen. -->
        <receiver
            android:name=".shortcuts.StateWidget"
            android:exported="false"
            android:label="@string/state_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_state_info" />
        </receiver>
        <!-- N5b: incoming texts forwarded to the computer, once the user
             turns it on in Settings and grants RECEIVE_SMS. -->
        <receiver
            android:name=".notify.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- N5b: the radio's answer for each part of a reply. -->
        <receiver
            android:name=".notify.SmsSentReceiver"
            android:exported="false" />

        <!-- N5a: the phone's notifications shown on the desktop, once the
             user turns it on in Settings and grants notification access. -->
        <service
            android:name=".notify.PhoneNotificationListener"
            android:exported="true"
            android:label="@string/phone_notifications_service"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Images received from the desktop's clipboard (N4): the clipboard
             grants each app that reads it access to the URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.clipboard"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/clipboard_paths" />
        </provider>
        <!-- D1: after the app or the system updated, what stopped working. -->
        <receiver
            android:name=".doctor.HealthReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- N1: Stop on the ring from the computer. -->
        <receiver
            android:name=".ring.StopRingReceiver"
            android:exported="false" />
    </application>

</manifest>
