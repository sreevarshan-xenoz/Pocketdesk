<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview of the music widget (I2): a sample track. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseCompoundDrawables,NestedWeights"
    android:id="@+id/preview_media_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_ll_music"
            android:tint="@color/widget_accent" />

        <TextView
            android:id="@+id/preview_media_host"
            android:text="@string/widget_preview_computer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/preview_media_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="160dp"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/preview_media_refresh"
            style="@style/WidgetRefresh"
            android:contentDescription="@string/media_widget_refresh" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/preview_media_track"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/preview_media_title"
            android:text="@string/widget_preview_track"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/preview_media_subline"
            android:text="@string/widget_preview_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/preview_media_previous"
                style="@style/WidgetIconButton"
                android:contentDescription="@string/media_widget_previous"
                android:src="@drawable/ic_ll_skip_previous" />

            <ImageView
                android:id="@+id/preview_media_play"
                style="@style/WidgetIconButton"
                android:contentDescription="@string/media_widget_play"
                android:src="@drawable/ic_ll_pause" />

            <ImageView
                android:id="@+id/preview_media_next"
                style="@style/WidgetIconButton"
                android:contentDescription="@string/media_widget_next"
                android:src="@drawable/ic_ll_skip_next" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/preview_media_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/preview_media_message_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_ll_refresh"
            android:tint="@color/widget_on_surface_variant" />

        <TextView
            android:id="@+id/preview_media_message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="3"
            android:text="@string/deck_loading"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
