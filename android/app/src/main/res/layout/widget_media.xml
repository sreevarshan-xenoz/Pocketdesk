<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_media_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_media_host"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_media_refresh"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:contentDescription="@string/media_widget_refresh"
            android:gravity="center"
            android:text="@string/deck_widget_refresh_glyph"
            android:textColor="@color/widget_on_surface"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_media_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_media_subline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_media_previous"
            style="@style/DeckWidgetButton"
            android:contentDescription="@string/media_widget_previous"
            android:text="@string/media_widget_previous_glyph"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/widget_media_play"
            style="@style/DeckWidgetButton"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/widget_media_next"
            style="@style/DeckWidgetButton"
            android:contentDescription="@string/media_widget_next"
            android:text="@string/media_widget_next_glyph"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_media_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp" />
</LinearLayout>
