<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview of the state widget (I2): sample readings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/preview_state_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_stat_pocketdesk"
            android:tint="@color/widget_accent" />

        <TextView
            android:id="@+id/preview_state_host"
            android:text="@string/widget_preview_computer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/preview_state_when"
            android:text="@string/widget_preview_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="180dp"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/preview_state_numbers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:textColor="@color/widget_on_surface"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/preview_state_row_cpu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/preview_state_label_cpu"
            android:text="@string/state_cpu"
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/preview_state_bar_cpu"
            android:progress="23"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:max="100"
            android:progressBackgroundTint="@color/widget_tile"
            android:progressTint="@color/widget_accent" />

        <TextView
            android:id="@+id/preview_state_value_cpu"
            android:text="@string/widget_preview_percent_cpu"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/preview_state_row_memory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/preview_state_label_memory"
            android:text="@string/state_memory"
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/preview_state_bar_memory"
            android:progress="58"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:max="100"
            android:progressBackgroundTint="@color/widget_tile"
            android:progressTint="@color/widget_accent" />

        <TextView
            android:id="@+id/preview_state_value_memory"
            android:text="@string/widget_preview_percent_memory"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/preview_state_row_disk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/preview_state_label_disk"
            android:text="@string/widget_preview_disk"
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/preview_state_bar_disk"
            android:progress="71"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:max="100"
            android:progressBackgroundTint="@color/widget_tile"
            android:progressTint="@color/widget_accent" />

        <TextView
            android:id="@+id/preview_state_value_disk"
            android:text="@string/widget_preview_percent_disk"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/preview_state_row_battery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/preview_state_label_battery"
            android:text="@string/state_battery"
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/preview_state_bar_battery"
            android:progress="86"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:max="100"
            android:progressBackgroundTint="@color/widget_tile"
            android:progressTint="@color/widget_accent" />

        <TextView
            android:id="@+id/preview_state_value_battery"
            android:text="@string/widget_preview_percent_battery"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
