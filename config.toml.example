# Pocketdesk server configuration (read by the `pocketdesk` command)
# Copy this file to ~/.config/pocketdesk/config.toml and customize.

# Control port (KDE Connect compatible)
control_port = 1716

# QUIC streaming port
streaming_port = 4716

# Log level: trace, debug, info, warn, error
log_level = "info"

# Video quality preset: low, balanced, high
video_quality = "balanced"

# Require PIN pairing before the control channel serves plugin requests.
# Set false to let any device on the trusted network connect without pairing.
# pairing_required = true

# Allow H.265/HEVC when a connecting phone declares it can decode it (R4 C1).
# Default false: sessions stay H.264. Only turn this on if the box actually
# has a working HEVC encoder (libx265 or a hardware hevc path).
# allow_hevc = false

# On a link too slow for the session's frame rate, step it down (60, 30, 15)
# so each frame keeps enough bits to stay readable, and back up once the
# link has room (R6f). A phone's "Full quality" turns it off for its session.
# slow_link_frame_rate = true

# Announce this computer on the local network (mDNS), so the phone app lists
# it under "On this network". Turn off to stay unlisted, e.g. on public Wi-Fi.
# lan_discovery = true

# GNOME and KDE: keep the screen-sharing portal's grant until you revoke it,
# so after you allow it once, sessions start with no one at this computer
# (see SECURITY.md). Off, the portal asks at every session.
# remember_screen_grant = false

# Relays for phones away from home: your own (`pocketdesk relay`) instead of
# n0's public ones. The phone learns it from this desktop; restart the server
# after changing it.
# relay_urls = ["https://relay.example.org"]

# What this desktop publishes on the BitTorrent Mainline DHT under its WAN id,
# so a phone away from home finds it after its relay or address changed:
#   "relay"     - the relay URLs only (the default)
#   "addresses" - the relay URLs and this computer's public IP addresses, so a
#                 phone can connect with no relay at all when the desktop has
#                 a public IPv6 address or a mapped port. The record then shows
#                 your home's public IP to anyone who knows the id.
#   "off"       - nothing; a phone away from home dials what it learned at home
# Private, LAN and tailnet addresses and home-network names are never
# published. In every mode but "off", the DHT nodes storing the record see the
# home IP it is sent from, tied to this id (see SECURITY.md). Restart the
# server after changing it.
# dht_publish = "relay"

# The phones' own notifications (a phone shares them only when its owner turns
# it on, app by app): show them here at all, and at most how many a minute
# from one phone. Each phone's Notifications permission (desktop app, Devices)
# still applies.
# phone_notifications = true
# notifications_per_minute = 20
# A phone notification the phone lets this computer answer shows its buttons
# and a reply box (Windows toasts; Linux servers with actions, and KDE's
# inline reply). Off: plain, and the desktop app's Notifications page answers.
# toast_answers = true

# Where files from phones, computers and KDE Connect devices land: an
# absolute folder. Empty (the default) is Downloads; a folder that is gone
# falls back to Downloads.
# downloads_folder = ""

# The desktop app's window showing a phone's screen controls the phone, once
# the phone allows it ("Let the computer control this phone" in its Settings).
# Off: the window only shows.
# cast_control = true

# Texts a phone forwards (Messages in the desktop app): a notification for
# each, and how many the history keeps.
# sms_notify = true
# sms_keep = 1000
# Keep the contact names a phone sends with its texts (when the phone shares
# them: its Settings, "Names from my contacts").
# sms_names = true

# Move files with a phone linked by the internet road, on a stream of its own
# control connection (nothing dials the phone back). Relays see sizes and
# timing, never content. Each phone's Files permission still applies.
# internet_files = true

# Received files keep the date they were last changed where they came from,
# and files sent from here carry theirs (`lastModified` on the share and the
# offer). Read at each transfer.
# keep_file_dates = true

# A link a phone hands over ("Open on computer"): opened in the default
# browser, or, false, shown as a notification. Each phone's Links
# permission (desktop app, Devices) still applies.
# open_links = true
# Let a phone with Input add a screen of its own shape (Sway only).
# virtual_screens = true

# A notification when a phone in a session reports a low battery (15 % or
# less, not charging).
# phone_battery_alerts = true

# Waking this computer from the phone. Paired phones are told this
# computer's network adapter (MAC and broadcast address) so they can send
# the magic packet themselves. To wake it from outside, forward a UDP port
# on the router to this computer and give that port here; 0 means none.
# wake_announce = true
# wake_port = 0

# Several phones at once: "one" lets the first phone to send input drive
# until it has been quiet for input_idle_secs (the desktop app can hand
# control over); "shared" lets every phone with the Input permission drive.
# input_control = "one"
# input_idle_secs = 10

# Windows only: the playback device the phone's microphone is played into,
# matched by (part of) its name. Windows needs a virtual audio cable for a
# program to provide a microphone; apps then record from its other end.
# Default "CABLE Input" (a stock VB-CABLE install).
# mic_relay_device = "CABLE Input"

# Home Assistant over MQTT (off by default): this computer, its phones and
# its tasks appear in Home Assistant by MQTT discovery. Plain MQTT only.
# home_assistant = true
# mqtt_broker = "mqtt://homeassistant.local:1883"
# mqtt_user = "pocketdesk"
# mqtt_password = ""   # the broker's password, when it asks for one
