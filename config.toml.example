# Pocketdesk server configuration (read by the `pocketdesk` command)
# Copy this file to ~/.config/pocketdesk/config.toml and customize.

# Control port (KDE Connect compatible)
control_port = 1716

# QUIC streaming port
streaming_port = 4716

# Log level: trace, debug, info, warn, error
log_level = "info"

# Video quality preset: low, balanced, high
video_quality = "balanced"

# Require PIN pairing before the control channel serves plugin requests.
# Set false to let any device on the trusted network connect without pairing.
# pairing_required = true

# Allow H.265/HEVC when a connecting phone declares it can decode it (R4 C1).
# Default false: sessions stay H.264. Only turn this on if the box actually
# has a working HEVC encoder (libx265 or a hardware hevc path).
# allow_hevc = false

# On a link too slow for the session's frame rate, step it down (60, 30, 15)
# so each frame keeps enough bits to stay readable, and back up once the
# link has room (R6f). A phone's "Full quality" turns it off for its session.
# slow_link_frame_rate = true

# Smooth keyframes: no whole keyframe every two seconds (several times the
# size of any other frame, so a hitch in the video each time). The software
# encoder and NVENC spread it over the stream; VA-API sends one every ten
# seconds; the FFmpeg sidecar keeps its two. A viewer that loses a frame
# still gets a whole one at once. Default true; false sends a whole keyframe
# every two seconds as before. Read when the server starts.
# smooth_keyframes = true

# Copy the screen through memory instead of the graphics card. On a Linux
# desktop built on wlroots (Sway, Hyprland) with VA-API video, the screen is
# rendered into a buffer on the card and encoded from there, with no copy and
# no upload; turn this on to copy it as before. Default false. Read when the
# server starts. (POCKETDESK_CAPTURE_COPY=1 does the same for one run.)
# capture_copy = false

# Announce this computer on the local network (mDNS), so the phone app lists
# it under "On this network". Turn off to stay unlisted, e.g. on public Wi-Fi.
# lan_discovery = true

# GNOME and KDE: keep the screen-sharing portal's grant until you revoke it,
# so after you allow it once, sessions start with no one at this computer
# (see SECURITY.md). Off, the portal asks at every session.
# remember_screen_grant = false

# GNOME only: start the screen and the keyboard and mouse through mutter's own
# D-Bus API, which asks no one at this computer, instead of the screen-sharing
# dialog (what gnome-remote-desktop's headless mode does). Any program running
# as you can make the same calls, so it is off by default (see SECURITY.md).
# If mutter's D-Bus is missing or refuses, the portal is used.
# gnome_unattended = false

# Offer a direct link: the Pair page's "Make a direct link" makes this
# computer's own Wi-Fi for one phone, for a train, a cafe with client
# isolation or a guest network where phones cannot reach this computer. You
# start each one, it turns itself off, and the phone joins it for Pocketdesk
# only. Linux through NetworkManager, Windows through the Mobile Hotspot.
# Off, the button is not shown.
# direct_link = true
# The band: "auto" (2.4 GHz, which every phone can join), "2.4" or "5".
# direct_link_band = "auto"
# Minutes with no phone using it before it turns itself off (1 to 120).
# direct_link_idle_minutes = 10

# Reachable from the internet: phones away from home and your other computers
# reach this computer, directly or through a relay, and the DHT keeps a record
# of it. Off, no relay or DHT is contacted and no router port is mapped: phones
# reach this computer on this network or through Tailscale only, and your other
# computers do not link with it. Restart the server after changing it.
# internet_path = true

# Relays for phones away from home: your own (`pocketdesk relay`) instead of
# n0's public ones. The phone learns it from this desktop; restart the server
# after changing it.
# relay_urls = ["https://relay.example.org"]

# What this desktop publishes on the BitTorrent Mainline DHT under its WAN id,
# so a phone away from home finds it after its relay or address changed:
#   "relay"     - the relay URLs only (the default)
#   "addresses" - the relay URLs and this computer's public IP addresses, so a
#                 phone can connect with no relay at all when the desktop has
#                 a public IPv6 address or a mapped port. The record then shows
#                 your home's public IP to anyone who knows the id.
#   "off"       - nothing; a phone away from home dials what it learned at home
# Private, LAN and tailnet addresses and home-network names are never
# published. In every mode but "off", the DHT nodes storing the record see the
# home IP it is sent from, tied to this id (see SECURITY.md). Restart the
# server after changing it.
# dht_publish = "relay"

# The phones' own notifications (a phone shares them only when its owner turns
# it on, app by app): show them here at all, and at most how many a minute
# from one phone. Each phone's Notifications permission (desktop app, Devices)
# still applies.
# phone_notifications = true
# notifications_per_minute = 20
# A phone notification the phone lets this computer answer shows its buttons
# and a reply box (Windows toasts; Linux servers with actions, and KDE's
# inline reply). Off: plain, and the desktop app's Notifications page answers.
# toast_answers = true

# Where files from phones, computers and KDE Connect devices land: an
# absolute folder. Empty (the default) is Downloads; a folder that is gone
# falls back to Downloads.
# downloads_folder = ""

# The desktop app's window showing a phone's screen controls the phone, once
# the phone allows it ("Let the computer control this phone" in its Settings).
# Off: the window only shows.
# cast_control = true

# The desktop app lists a Phone apps page: a linked phone's apps, to open one
# there with its screen in a window here. The phone decides whether it may be
# asked ("Let the computer open my apps", off by default). Off: not listed.
# phone_apps_page = true

# Right-click a phone app on that page to pin it to Start (Windows) or the
# applications menu (Linux): a shortcut named "<app> (phone)" that opens the
# app on the phone from this computer. Off: no pin menu; shortcuts already
# pinned keep working.
# phone_apps_pin = true

# A file dropped on a phone's screen window is also shared into the app in
# front on the phone, when that app takes it (the phone's "Let the computer
# open my apps" must be on, off by default). Off: a dropped file is only sent.
# phone_drop_share = true

# Open a phone's app in a window of its own, several at once, when the phone
# offers it (its "Separate windows (Shizuku)", off by default there, shown
# only with Shizuku running). Off, or with a phone that does not offer it, an
# app opens on the phone's own screen as before.
# phone_app_windows = true

# Keys to taps: play a phone's game from this computer's keyboard and mouse in
# its app window (needs the windows above, so Shizuku on the phone). A keymap
# is drawn per app in the window; the mouse aims while the pointer is locked.
# Off by default: some online games flag injected input.
# phone_app_keymaps = false

# Linux with NetworkManager: after "Use my phone's hotspot" (Overview, for a
# phone whose "Let my computers turn on my hotspot" is on, which needs Shizuku)
# asks the phone to turn its hotspot on, join the Wi-Fi network of this name,
# but only if it is already saved on this computer. The phone's password is
# never asked for, kept or sent. Empty: you are only told to connect.
# phone_hotspot_network = ""

# Linux: offer phones as this computer's camera. A phone with "Use its camera
# as a webcam" on in the desktop app (Devices) and "Let the computer use
# my camera" on in its Settings, asked from the Overview, is published as a
# PipeWire camera ("Pocketdesk camera (<phone>)") that browsers, OBS and
# video-call apps can open; V4L2-only apps reach it through pw-v4l2. No kernel
# module. Off by default. The lens (back or front), the height (720 or 1080)
# and the frame rate (15, 24 or 30) are what the phone is asked for.
# phone_camera = false
# phone_camera_lens = "back"
# phone_camera_height = 720
# phone_camera_fps = 30

# Linux: give this computer's apps the location of a phone, through GeoClue
# (night light, weather, time zone, maps). This computer serves one NMEA
# source on its loopback only and tells GeoClue about it over Avahi
# (`_nmea-0183._tcp`, on this computer's loopback only); when an app wants a
# place it asks the linked phone for one fix (at most every ten minutes) and
# hands it on. The phone must have "Give my computer my location" on in its
# own Settings. Nothing is stored or logged but the accuracy. Off by default.
# precision: "city" (rounded to about 1 km; the default) or "exact" (which the
# phone must also allow). phone: a paired phone's device id, or empty for any
# of your phones that is linked.
# phone_location = false
# phone_location_precision = "city"
# phone_location_phone = ""

# On Linux, the phone's gamepad is a game controller (an Xbox 360 pad's
# layout, through uinput) that games see. Off, or without uinput rights, it
# types keys and moves the mouse instead.
# gamepad_controller = true

# Texts a phone forwards (Messages in the desktop app): a notification for
# each, and how many the history keeps.
# sms_notify = true
# sms_keep = 1000
# Keep the contact names a phone sends with its texts (when the phone shares
# them: its Settings, "Names from my contacts").
# sms_names = true

# Move files with a phone linked by the internet road, on a stream of its own
# control connection (nothing dials the phone back). Relays see sizes and
# timing, never content. Each phone's Files permission still applies.
# internet_files = true

# Received files keep the date they were last changed where they came from,
# and files sent from here carry theirs (`lastModified` on the share and the
# offer). Read at each transfer.
# keep_file_dates = true

# A link a phone hands over ("Open on computer"): opened in the default
# browser, or, false, shown as a notification. Each phone's Links
# permission (desktop app, Devices) still applies.
# open_links = true
# Let a phone with Input add a screen of its own shape (Sway and Hyprland).
# virtual_screens = true
# Let my other computers (paired both ways, with the Input permission) borrow
# this computer's windows (Sway, Hyprland, Windows): a window moves to a hidden
# screen of its own size here and is shown on the other computer, and goes
# back where it was when it is returned, the other computer's session ends,
# or this server stops. On Windows there is no hidden screen: the window stays
# where it is, is shown on the other computer, and is clicked and typed into
# there. On GNOME (with gnome_unattended on, and a Shell that gives its window
# list) the window stays where it is and the other computer only looks at it.
# On KDE Plasma (Wayland) it stays where it is too and is only looked at: it is
# shown through the screen-sharing portal, which asks at this computer the
# first time for each window, and a small KWin script is loaded while one is
# lent to read the windows.
# On by default, for my computers paired both ways with Input only; false
# turns it off.
# lend_windows = true
# A window borrowed from another of my computers takes the size of the window
# that shows it here: resized, maximised or moved to a screen of another
# scale, the other computer sizes the window to the picture area in real
# pixels, so the picture stays sharp. Read by an open window at once.
# borrowed_window_follows_size = true
# Drag a window past the edge of this screen onto another of my computers
# (the shared keyboard and mouse must be on, and lend_windows above): a
# floating window dragged to the edge that leads there is lent to that
# computer and shown there where I let go (Sway and Hyprland). The computer
# it goes to needs this on too: it opens the window. On by default; false
# turns it off.
# drag_windows_across = true
# What marks a drag as a window being moved: "mod" (the default) wants the
# compositor's modifier, Super or Alt, held with the left button; "any" takes
# any left-button drag from a floating window that reaches the edge, a
# title-bar drag included (a text selection in that window counts too).
# drag_window_trigger = "mod"
# Let a phone with the Peek permission (off for every phone until turned
# on in the desktop app, Devices) see this screen as one still, from its
# Home, with no session.
# peek = true
# The Markdown file notes from phones are added to, with the time ('Note
# to computer' in the phone's share sheet), from phones with 'Add to my
# notes' on in the desktop app (Devices); empty: notes are refused.
# notes_file = ""

# A notification when a phone in a session reports a low battery (15 % or
# less, not charging).
# phone_battery_alerts = true

# Approve with my phone (Linux): sudo and administrator prompts approved on a
# linked phone with its fingerprint or screen lock, through
# /usr/lib/pocketdesk/pocketdesk-pam-ask, which you add to /etc/pam.d
# yourself as "auth sufficient" (Pocketdesk never edits PAM; the password
# always still works) after pinning the phone's key as root. Off by default.
# See docs/guide.md, "Approve With My Phone".
# phone_approves = false
# How long a request waits for the phone, 5 to 60 seconds.
# phone_approves_timeout_secs = 20
# The lock screen too (hyprlock, swaylock, KDE, gtklock), with its own PAM line.
# phone_approves_lock_screen = false
# polkit too, with its own PAM line: off, as PAM is not told polkit's action
# and the socket-started agent has no ancestry to judge ssh by.
# phone_approves_polkit = false
# Only from this desk: a request from an ssh session asks for the password (a
# best-effort guard: tmux, systemd-run or a timer over ssh get past it).
# phone_approves_local_only = true
# Which phones may approve (device ids); empty is every phone pinned.
# phone_approves_phones = []

# Waking this computer from the phone. Paired phones are told this
# computer's network adapter (MAC and broadcast address) so they can send
# the magic packet themselves. To wake it from outside, forward a UDP port
# on the router to this computer and give that port here; 0 means none.
# wake_announce = true
# wake_port = 0

# Several phones at once: "one" lets the first phone to send input drive
# until it has been quiet for input_idle_secs (the desktop app can hand
# control over); "shared" lets every phone with the Input permission drive.
# input_control = "one"
# input_idle_secs = 10

# One keyboard and mouse across your own paired computers (Windows and
# Linux): a pointer pushed past the edge of one screen appears on the next
# computer, and the keys follow it. Off until you turn it on, on each
# computer; each computer must also be allowed "Keyboard and mouse" in the
# other's Devices page (desktop app), which is off until you turn it on.
# shared_input = true
# This computer's keyboard and mouse may move onto the others; false, it only
# takes theirs.
# shared_input_drive = true
# A key that moves on to the next computer; "" is off, and the screen's edge
# still switches. Restart the server after changing it.
# shared_input_hotkey = "ctrl+alt+right"
# The pointer stays on this computer while a game runs, and while one of
# these programs (by file name) is the window in front.
# shared_input_game_lock = true
# shared_input_lock_programs = ["Blender.exe"]
# What is copied on one computer is ready to paste on the one the mouse goes to.
# shared_input_clipboard = true
# Windows: files dragged in Explorer and let go on another computer are sent
# to it ("Files over the internet" on on both).
# shared_input_files = true
# Windows: the sound of the computer the mouse is on plays here, while it is
# there (off until chosen).
# shared_input_sound = true
# Keep the connection quick while sharing: while the keyboard and mouse are on
# another computer, or this one is driven, Windows' timer runs at 1 ms for
# Pocketdesk, and a byte goes to the other computer's link port every 50 ms
# (only on this network) so this one's Wi-Fi does not doze between keys (a
# little more battery while it lasts).
# shared_input_low_latency = true

# Windows only: the playback device the phone's microphone is played into,
# matched by (part of) its name. Windows needs a virtual audio cable for a
# program to provide a microphone; apps then record from its other end.
# Default "CABLE Input" (a stock VB-CABLE install).
# mic_relay_device = "CABLE Input"

# Home Assistant over MQTT (off by default): this computer, its phones and
# its tasks appear in Home Assistant by MQTT discovery. Plain MQTT only.
# home_assistant = true
# mqtt_broker = "mqtt://homeassistant.local:1883"
# mqtt_user = "pocketdesk"
# mqtt_password = ""   # the broker's password, when it asks for one
