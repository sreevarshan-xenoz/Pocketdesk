# Pocketdesk server configuration (read by the `pocketdesk` command)
# Copy this file to ~/.config/pocketdesk/config.toml and customize.

# Control port (KDE Connect compatible)
control_port = 1716

# QUIC streaming port
streaming_port = 4716

# Log level: trace, debug, info, warn, error
log_level = "info"

# Video quality preset: low, balanced, high
video_quality = "balanced"

# Require PIN pairing before the control channel serves plugin requests.
# Set false to let any device on the trusted network connect without pairing.
# pairing_required = true

# Allow H.265/HEVC when a connecting phone declares it can decode it (R4 C1).
# Default false: sessions stay H.264. Only turn this on if the box actually
# has a working HEVC encoder (libx265 or a hardware hevc path).
# allow_hevc = false

# Announce this computer on the local network (mDNS), so the phone app lists
# it under "On this network". Turn off to stay unlisted, e.g. on public Wi-Fi.
# lan_discovery = true

# Windows only: the playback device the phone's microphone is played into,
# matched by (part of) its name. Windows needs a virtual audio cable for a
# program to provide a microphone; apps then record from its other end.
# Default "CABLE Input" (a stock VB-CABLE install).
# mic_relay_device = "CABLE Input"
